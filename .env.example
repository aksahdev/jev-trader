# Coinbase Advanced Trade public market-data WebSocket. Public level2, market_trades and heartbeats
# do not require API credentials.
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
PRODUCT_ID=BTC-USDC

# V0 is intentionally paper-only. Setting this false will make the app refuse to start.
DRY_RUN=true

# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
JEV_USD_PER_MTOK=0.042

# One decision per interval; Jev forecasts the configured horizon.
DECISION_INTERVAL_MS=1000
HORIZON_MS=30000

# Paper maker quote settings. PRICE_INCREMENT should match the product's quote increment.
PRICE_INCREMENT=0.01
QUOTE_INSIDE_TICKS=1
TRADE_SIZE_BASE=0.0001
MAX_POSITION_BASE=0.001
BANKROLL_USD=100

# Put your actual Coinbase maker fee tier here when evaluating net paper P&L.
PAPER_MAKER_FEE_BPS=0

PORT=3000
HISTORY_SIZE=1000

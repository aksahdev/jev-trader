# Coinbase remains the paper execution/reference venue.
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
PRODUCT_ID=BTC-USDC
# Usually inferred from PRODUCT_ID. Override only if needed.
# BASE_ASSET=BTC

# Keyless signal venues. Both are optional and fail soft if unavailable.
BINANCE_SIGNALS=true
BINANCE_WS_BASE=wss://stream.binance.com:9443
# Default: ${BASE_ASSET}USDT
# BINANCE_SYMBOL=BTCUSDT

UPBIT_SIGNALS=true
UPBIT_WS_URL=wss://api.upbit.com/websocket/v1
# Defaults: KRW-${BASE_ASSET} and KRW-USDT.
# UPBIT_ASSET_CODE=KRW-BTC
UPBIT_FX_CODE=KRW-USDT
SIGNAL_MAX_AGE_MS=5000

# V0 is intentionally paper-only. Setting this false makes the app refuse to start.
DRY_RUN=true

# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
JEV_USD_PER_MTOK=0.042

# One decision per interval; Jev forecasts the configured horizon.
DECISION_INTERVAL_MS=1000
HORIZON_MS=30000

# Paper maker quote settings. PRICE_INCREMENT must match the Coinbase product.
PRICE_INCREMENT=0.01
QUOTE_INSIDE_TICKS=1
TRADE_SIZE_BASE=0.0001
MAX_POSITION_BASE=0.001
BANKROLL_USD=100

# Put your actual Coinbase maker fee tier here before judging net paper P&L.
PAPER_MAKER_FEE_BPS=0

PORT=3000
HISTORY_SIZE=1000

# Example profiles:
#
# BTC:
# PRODUCT_ID=BTC-USDC
# PRICE_INCREMENT=0.01
# TRADE_SIZE_BASE=0.0001
# MAX_POSITION_BASE=0.001
#
# SOL:
# PRODUCT_ID=SOL-USDC
# PRICE_INCREMENT=0.01
# TRADE_SIZE_BASE=0.01
# MAX_POSITION_BASE=0.1
#
# SHIB (verify the exact Coinbase product/tick available to your account before running):
# PRODUCT_ID=SHIB-USD
# PRICE_INCREMENT=0.00000001
# TRADE_SIZE_BASE=100000
# MAX_POSITION_BASE=1000000
